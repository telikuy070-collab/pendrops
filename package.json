{
  "name": "pendrops-schedule",
  "version": "1.7.0",
  "description": "PWA-приложение для отображения расписания мед. колледжа из Excel",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:teacher": "vite --config vite.teacher.config.js",
    "build": "tsc --noEmit && vite build",
    "build:teacher": "tsc --noEmit -p tsconfig.teacher.json && vite build --config vite.teacher.config.js",
    "preview": "vite preview",
    "preview:teacher": "vite preview --config vite.teacher.config.js",
    "test": "vitest run",
    "test:teacher": "vitest run teacher-app/tests",
    "test:watch": "vitest",
    "test:edge": "node tests/edge-cases.js",
    "test:store": "node tests/store-audit.js",
    "test:security": "node tests/security-audit.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:teacher": "tsc --noEmit -p tsconfig.teacher.json",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^2.1.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "zod": "^4.5.4"
  }
}
